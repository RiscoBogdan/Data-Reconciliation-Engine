export SQLITE_PATH="/Users/your-user/IdeaProjects/compare_engine/reconciler_diffs.db"

# Optional schema mapping overrides used by reconciler.mappings
export MAP_SCHEMA_ID_2="ORACLE_SCHEMA1"
