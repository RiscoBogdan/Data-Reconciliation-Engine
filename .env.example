export MAP_SNOWFLAKE_SCHEMA_2="PUBLIC"
export MAP_DEST_FILTER_COL_2="SOURCE_SCHEMA_ID"
export MAP_DEST_FILTER_VAL_2="ORACLE_SCHEMA1"
export MAP_ENABLED_2="true"

export MAP_SCHEMA_ID_3="ORACLE_SCHEMA2"
